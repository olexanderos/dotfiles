[includeIf "hasconfig:remote.*.url:git@github.com:olexanderos/**"]
  path = ~/.config/git/gh-private
[init]
  defaultBranch = main
[include]
  path = ~/.config/delta/themes.gitconfig
[delta]
  features = gruvmax-fang

[core]
  pager = delta
  compression = 9  # trade cpu for network

[interactive]
  diffFilter = delta --color-only

[commit]
    template = ~/.config/git/template

[log]
    abbrevCommit = true  # short commits
    graphColors = blue,yellow,cyan,magenta,green,red

[status]
    branch = true
    short = true
    showStash = true
    showUntrackedFiles = all  # show individual untracked files

[color "branch"]
    current  = magenta
    local    = default
    remote   = yellow
    upstream = green
    plain    = blue

[color "diff"]
    meta       = black bold
    frag       = magenta
    context    = white
    whitespace = yellow reverse

